{
  "name": "poc-crossmint-buyer",
  "version": "0.1.0",
  "private": true,
  "description": "Crossmint のエージェントウォレット／エージェントカードを買い手にして、JIN（x402）と実証1の Nevermined プランを買う実証",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "probe:jin": "tsx scripts/probe-jin.ts",
    "wallet:setup": "tsx scripts/wallet-setup.ts",
    "x402:local": "tsx scripts/x402-local-server.ts",
    "buy:jin": "tsx scripts/buy-jin.ts",
    "probe:solana": "tsx scripts/probe-solana.ts",
    "enroll": "tsx scripts/enroll-server.ts",
    "card:flow": "tsx scripts/run-card-flow.ts",
    "jwks": "tsx -e \"import('./src/crossmint/custom-jwt.ts').then(async m => console.log((await m.writeJwks()) ? 'web/public/jwks.json を更新した（コミット・プッシュが要る）' : '変更なし'))\""
  },
  "dependencies": {
    "@crossmint/common-sdk-base": "0.13.0",
    "@crossmint/wallets-sdk": "1.20.4",
    "@nevermined-io/payments": "1.13.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "dotenv": "18.0.9",
    "jose": "6.2.13",
    "playwright-core": "1.64.1",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@crossmint/client-sdk-react-ui": "4.11.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
