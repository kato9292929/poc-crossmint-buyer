# .env にコピーして値を入れる。.env はコミットしない（.gitignore 済み）。
# カード番号・CVC はどこにも書かない（このリポジトリのコードも読み書きしない）。

# --- 共通 ---
# ログを logs/YYYY-MM-DD.jsonl（JST）に出すのは development のときだけ（実証1と同じ）
NODE_ENV=development

# --- フェーズA：サーバー側エージェントウォレット ---
# Crossmint コンソールのサーバー側 API キー（sk_staging_… / sk_production_…）
# 必要なスコープ: wallets.create, wallets.read, wallets:transactions.create, wallets:transactions.sign,
#               wallets:signatures.create, wallets:balance.read, wallets.fund（staging のみ）
CROSSMINT_SERVER_API_KEY=
# サーバー署名者のシークレット（xmsk1_ + 64桁の16進）。生成: echo "xmsk1_$(openssl rand -hex 32)"
# Crossmint には送られない。失くすとウォレットを動かせなくなるので、パスワードマネージャーにも控える
CROSSMINT_SIGNER_SECRET=
# ウォレットの alias（既定 poc-crossmint-buyer）
# CROSSMINT_WALLET_ALIAS=poc-crossmint-buyer
# 本番キー（sk_production_）で動かすときだけ true にする
# ALLOW_PRODUCTION=true
# 上限を下げるときだけ（コードの上限 1回 $0.05・1日 $0.50 より上には上げられない）
# MAX_USD_PER_CALL=0.05
# MAX_USD_PER_DAY=0.50

# --- フェーズB：エージェントカード（web/enroll） ---
# Crossmint コンソールのクライアント側 API キー（ck_staging_…）。staging は全スコープ付き
# 本番で使う場合のスコープ: payment-methods.create, payment-methods.read, payment-methods.update,
#                         order-intents.create, order-intents.read, order-intents.credentials,
#                         users.create, users.read
# 許可するオリジン: http://localhost:5174
CROSSMINT_CLIENT_API_KEY=
# 実証1の Nevermined の買い手の API キー（sandbox:…）。プランの Stripe Checkout の URL を作るのに使う
NVM_API_KEY_BUYER=
# 実証1のプラン ID（既定は実証1の config/sandbox.json の値）
# NVM_PLAN_ID=
# ブラウザを画面に出して支払いを見るとき
# HEADFUL=true
